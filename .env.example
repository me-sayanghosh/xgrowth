# Copy to .env locally. Never commit .env.
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
APP_SESSION_SECRET=replace_with_long_random_secret

MONGODB_URI=mongodb://127.0.0.1:27017/xgrowth_ai

GEMINI_API_KEY=
GEMINI_MODEL=

# Single-owner setup: create a personal API key in Buffer Settings → API.
# Keep this server-side only. Do not expose it to frontend code.
BUFFER_API_KEY=

# Optional notification provider
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=
NOTIFICATION_TARGET=
