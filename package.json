{
  "name": "xgrowth-ai-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Buffer-first AI-assisted content operations platform for X",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "node packages/mcp/dist/cli.js",
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "seed": "npm run seed --workspace=@xgrowth/api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "eslint": "^9.20.0",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
